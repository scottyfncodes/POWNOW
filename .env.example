# POW NOW environment variables.
#
# There is exactly one safe default: copy nothing, set nothing, and the app
# runs entirely in demo mode. Every variable below opts into live mode or a
# piece of it — none is required. In live mode, a piece with nothing
# configured (or that fails) reports UNAVAILABLE, never demo data: the
# production build has no live-mode path that falls back to demo. See
# README.md → "Going live" and "The production data gate".

# ---------------------------------------------------------------------------
# Client (Vite) — baked into the static bundle at BUILD time, not read at
# runtime. Changing these means rebuilding, not just restarting a server.
# None of these are secrets: a base URL is not a credential.
# ---------------------------------------------------------------------------

# "demo" (default) or "live". Demo needs nothing else below.
VITE_DATA_MODE=demo

# Where the data proxy (server/) lives. It carries everything a browser can't
# fetch itself: traffic (Google Routes), road conditions (CDOT) and measured
# snowpack (SNOTEL). Three meanings:
#   (unset)                     no proxy — all three report UNAVAILABLE
#   /                           same origin — the proxy is deployed beside the
#                               frontend as serverless functions under /api
#                               (the Vercel layout; vercel.json sets this)
#   https://proxy.example.com   a separately hosted proxy (Render, a VPS)
# Never point this at a URL that doesn't actually run the proxy.
VITE_API_BASE_URL=

# CDOT/COtrip road conditions (src/providers/live/cotripRoad.ts). On by
# default in live mode when the proxy is configured — it fails safe
# (UNAVAILABLE) on any response it doesn't recognize. Set to "false" to
# disable outright.
VITE_ENABLE_ROAD_CONDITIONS=true

# ---------------------------------------------------------------------------
# Server (server/index.mjs) — never bundled into the client, never sent to the
# browser. This is where the secrets live. On Vercel these are the project's
# environment variables (the same file runs as api/[...path].mjs); on a
# long-lived host they are the process environment.
# ---------------------------------------------------------------------------

# Required for traffic. Without it every travel request gets an honest 503,
# which the client turns into "traffic unavailable" — never a fabricated
# drive time. Google Cloud → Routes API → credentials.
GOOGLE_ROUTES_API_KEY=

# Required for road conditions. A free registered key from CDOT's developer
# portal (data.cotrip.org). Without it /api/road-conditions answers 503 and
# the client reports roads UNAVAILABLE.
COTRIP_API_KEY=

# SNOTEL (measured snowpack) needs no key — the NRCS AWDB API is public. The
# proxy exists for it only because that API does not serve CORS.

# Standalone process only (ignored on Vercel).
PORT=8787

# Optional shared cache for serverless deployments: a Redis-compatible REST
# store (Vercel KV / Upstash). Without it each warm function instance keeps
# its own in-memory cache, which is fine at personal-use volume; with it, a
# cold instance starts warm and every instance shares one Google budget.
# Vercel KV sets both of these on the project automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Cache windows, in seconds, shared across every visitor.
TRAFFIC_CACHE_TTL_SECONDS=900
ROAD_CACHE_TTL_SECONDS=300
SNOTEL_CACHE_TTL_SECONDS=1800

# Which browser origins may call this proxy. Same-origin deployments (Vercel)
# can leave this at "*" — the browser never sends a cross-origin request. A
# separately hosted proxy should list the deployed frontend, comma-separated
# if several:
#   CORS_ORIGIN=https://pownow.example.com
# A browser request from any other origin is refused before it costs a Google
# call. Requests with no Origin header (curl, health checks) are still served,
# bounded by the rate limit below.
CORS_ORIGIN=*

# Per-IP request budget per minute. Past it, 429.
RATE_LIMIT_PER_MINUTE=90

# The dataset is Colorado-only today, so departure times are interpreted in
# this IANA zone. Change only if you add mountains outside it.
POWNOW_TIME_ZONE=America/Denver
